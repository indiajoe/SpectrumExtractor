### LLM contribution acknowledgment: This file is generated by Fable 5 model based on the prompt given by JPN
# SpectrumExtractor/meson.build

# ---------------------------------------------------------------------------
# 1. Pure-Python sources
#
# meson-python requires every installed file to be listed explicitly
# (no globbing). Add EVERY .py file (and any data file, e.g. .json/.dat
# config files previously picked up by include_package_data) that lives
# in this directory to the list below.
# ---------------------------------------------------------------------------
py_sources = [
  '__init__.py',
  'spectrum_extractor.py',
  'cosmic_ray_utils.py',
  'scattered_light_subtraction.py',
]

py.install_sources(
  py_sources,
  subdir: 'SpectrumExtractor',   # install into site-packages/SpectrumExtractor/
)

install_data(
  'spectrum_extractor.config',
  install_dir: py.get_install_dir() / 'SpectrumExtractor',
)

# ---------------------------------------------------------------------------
# 2. Fortran extension module via f2py
#
# Step 1: run f2py on laplace_filter.f95 to generate the C API wrapper.
# Since NumPy 1.22.4, f2py deterministically generates the (possibly
# empty) `<module>-f2pywrappers.f` file for plain subroutine sources,
# so both outputs below are always produced.
#
# NOTE: if laplace_filter.f95 contains Fortran `module` blocks, f2py
# additionally emits `laplace_filter-f2pywrappers2.f90` -- run
#   python -m numpy.f2py SpectrumExtractor/laplace_filter.f95 \
#          -m laplace_filter --lower --build-dir /tmp/f2pycheck
# once and add any extra generated file to the `output:` list.
# ---------------------------------------------------------------------------
laplace_filter_source = custom_target(
  'laplace_filter_f2py',
  input: 'laplace_filter.f95',
  output: [
    'laplace_filtermodule.c',
    'laplace_filter-f2pywrappers.f',
  ],
  command: [
    py, '-m', 'numpy.f2py',
    '@INPUT@',
    '-m', 'laplace_filter',
    '--lower',
    '--build-dir', '@OUTDIR@',
  ],
)

# Step 2: compile the generated C + wrapper Fortran + original Fortran
# into the extension module SpectrumExtractor.laplace_filter
py.extension_module(
  'laplace_filter',
  ['laplace_filter.f95', laplace_filter_source],
  include_directories: inc_np,
  dependencies: [py_dep, fortranobject_dep],
  install: true,
  subdir: 'SpectrumExtractor',   # -> SpectrumExtractor/laplace_filter.*.so
)
