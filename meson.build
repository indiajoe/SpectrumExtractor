### LLM contribution acknowledgment: This file is generated by Fable 5 model based on the prompt given by JPN
# Root meson.build for SpectrumExtractor
project(
  'SpectrumExtractor',
  'c',
  version: '0.3',
  license: 'LGPL-3.0-or-later',
  meson_version: '>=1.1.0',
  default_options: [
    'buildtype=release',
    'warning_level=1',
  ],
)

# Fortran added separately so C-only introspection steps still work
add_languages('fortran', native: false)

py = import('python').find_installation(pure: false)
py_dep = py.dependency()

# Locate NumPy and f2py headers of the *build-time* Python environment
incdir_numpy = run_command(
  py, ['-c', 'import numpy; print(numpy.get_include())'],
  check: true,
).stdout().strip()

incdir_f2py = run_command(
  py, ['-c', 'import numpy.f2py; print(numpy.f2py.get_include())'],
  check: true,
).stdout().strip()

inc_np = include_directories(incdir_numpy, incdir_f2py)

# fortranobject.c ships with f2py and must be compiled into every
# f2py-generated extension module. Build it once as a static library.
fortranobject_c = incdir_f2py / 'fortranobject.c'

fortranobject_lib = static_library(
  '_fortranobject',
  fortranobject_c,
  dependencies: py_dep,
  include_directories: inc_np,
)

fortranobject_dep = declare_dependency(
  link_with: fortranobject_lib,
  include_directories: inc_np,
)

subdir('SpectrumExtractor')
